# ─── Site ────────────────────────────────────────────────────────────
# Public URL of the site, no trailing slash (used for canonical URLs, sitemap, OG tags, emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Database ────────────────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/zylo
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/zylo?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/zylo

# ─── Admin login ─────────────────────────────────────────────────────
ADMIN_EMAIL=admin@zylosolution.com
# Generate with:  npm run hash-password -- "YourStrongPassword"
# In .env files every "$" must be escaped as "\$" (the script prints the escaped form).
# In the Vercel dashboard paste the raw hash without backslashes.
ADMIN_PASSWORD_HASH=
# Long random string (at least 32 chars). e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ─── Email (SMTP) ────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# true for port 465, false for 587 (STARTTLS)
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# "From" address shown on outgoing emails
SMTP_FROM="Zylo Solution <no-reply@zylosolution.com>"
# Where new booking notifications are delivered
BOOKING_NOTIFY_EMAIL=Info@zylosolution.com

# ─── Web Push (generate with: npm run generate-vapid-keys) ──────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:Info@zylosolution.com

# ─── Cloudinary (image uploads from the admin panel) ────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=zylo
